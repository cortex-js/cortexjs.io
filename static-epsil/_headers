# Cloudflare Pages headers for epsil.dev.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # .dev is on the HSTS preload list, so HTTPS is already mandatory in browsers;
  # this makes the site's own policy explicit for everything else.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Docusaurus fingerprints everything under /assets/, so it can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The lunr search index carries a content hash in its filename, so a stale copy
# can never be served for changed content. It is fetched on first use of the
# search box, which makes caching it hard worth more than it does for /assets/.
/search-index-*.json
  Cache-Control: public, max-age=31536000, immutable

# The machine-readable bundles are plain text, not downloads.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-*.txt
  Content-Type: text/plain; charset=utf-8
/*.md
  Content-Type: text/markdown; charset=utf-8
